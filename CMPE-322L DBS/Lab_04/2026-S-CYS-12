Task 12: Customers Who Never Placed an Order
SELECT 
    c.id AS CustomerID,
    CONCAT(c.first_name, ' ', c.last_name) AS CustomerName
FROM customers c
LEFT JOIN orders o ON c.id = o.customer_id
WHERE o.id IS NULL;
***


Task 13: Customer Pairs Who Ordered on Same Date
SELECT DISTINCT
    c1.id AS Customer1ID,
    CONCAT(c1.first_name, ' ', c1.last_name) AS Customer1Name,
    c2.id AS Customer2ID,
    CONCAT(c2.first_name, ' ', c2.last_name) AS Customer2Name,
    DATE(o1.order_date) AS OrderDate
FROM orders o1
INNER JOIN orders o2 ON DATE(o1.order_date) = DATE(o2.order_date)
INNER JOIN customers c1 ON o1.customer_id = c1.id
INNER JOIN customers c2 ON o2.customer_id = c2.id
WHERE c1.id < c2.id;
***


Task 14: Employee Pairs Who Served Same Customer
SELECT DISTINCT
    c.id AS CustomerID,
    CONCAT(c.first_name, ' ', c.last_name) AS CustomerName,
    e1.id AS Employee1ID,
    CONCAT(e1.first_name, ' ', e1.last_name) AS Employee1Name,
    e2.id AS Employee2ID,
    CONCAT(e2.first_name, ' ', e2.last_name) AS Employee2Name
FROM orders o1
INNER JOIN orders o2 ON o1.customer_id = o2.customer_id
INNER JOIN customers c ON o1.customer_id = c.id
INNER JOIN employees e1 ON o1.employee_id = e1.id
INNER JOIN employees e2 ON o2.employee_id = e2.id
WHERE e1.id < e2.id;
***
